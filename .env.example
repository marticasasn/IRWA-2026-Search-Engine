SECRET_KEY="change-me-to-a-random-string"
DEBUG=True
SESSION_COOKIE_NAME="IRWA_SEARCH_ENGINE"
DATA_FILE_PATH="fashion_products_dataset.json"

GROQ_API_KEY=<your key>
