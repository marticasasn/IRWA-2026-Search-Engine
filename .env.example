# (e.g. openai/gpt-oss-20b, used to generate docs/rag_comparison.md)
GROQ_MODEL="llama-3.1-8b-instant"

# Optional: analytics file (default data/analytics.json)
# ANALYTICS_FILE=data/analytics.json
